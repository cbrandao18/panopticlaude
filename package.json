{
  "name": "panopticlaude",
  "displayName": "Panopticlaude",
  "description": "Mission control for Claude Code sessions and cron bots. One sidebar. All your Claudes. Nowhere to hide.",
  "version": "0.5.0",
  "publisher": "cbrandao18",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cbrandao18/panopticlaude"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "panopticlaude",
          "title": "Panopticlaude",
          "icon": "media/eye.svg"
        }
      ]
    },
    "views": {
      "panopticlaude": [
        {
          "id": "panopticlaude.sessions",
          "name": "Sessions",
          "when": "!panopticlaude.gui"
        },
        {
          "id": "panopticlaude.prs",
          "name": "My PRs",
          "when": "!panopticlaude.gui"
        },
        {
          "id": "panopticlaude.worktrees",
          "name": "Worktrees",
          "when": "!panopticlaude.gui",
          "visibility": "collapsed"
        },
        {
          "id": "panopticlaude.crons",
          "name": "Crons",
          "when": "!panopticlaude.gui"
        },
        {
          "type": "webview",
          "id": "panopticlaude.gui",
          "name": "Mission Control",
          "when": "panopticlaude.gui"
        }
      ]
    },
    "commands": [
      {
        "command": "panopticlaude.refresh",
        "title": "Panopticlaude: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "panopticlaude.showGui",
        "title": "Switch to GUI View",
        "icon": "$(preview)"
      },
      {
        "command": "panopticlaude.showTree",
        "title": "Switch to Tree View",
        "icon": "$(list-tree)"
      },
      {
        "command": "panopticlaude.installHooks",
        "title": "Panopticlaude: Install Claude Code Hooks"
      },
      {
        "command": "panopticlaude.markInboxReviewed",
        "title": "Mark Inbox Reviewed",
        "icon": "$(check-all)"
      },
      {
        "command": "panopticlaude.cleanWorktrees",
        "title": "Panopticlaude: Clean Up Worktrees",
        "icon": "$(trash)"
      },
      {
        "command": "panopticlaude.openTodayDraft",
        "title": "Open Today's Draft",
        "icon": "$(book)"
      },
      {
        "command": "panopticlaude.postDrafts",
        "title": "Post Drafts to GitHub",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "panopticlaude.refresh",
          "when": "view == panopticlaude.sessions || view == panopticlaude.prs || view == panopticlaude.worktrees || view == panopticlaude.crons || view == panopticlaude.gui",
          "group": "navigation"
        },
        {
          "command": "panopticlaude.showGui",
          "when": "view == panopticlaude.sessions || view == panopticlaude.prs || view == panopticlaude.worktrees || view == panopticlaude.crons",
          "group": "navigation"
        },
        {
          "command": "panopticlaude.showTree",
          "when": "view == panopticlaude.gui",
          "group": "navigation"
        },
        {
          "command": "panopticlaude.cleanWorktrees",
          "when": "view == panopticlaude.worktrees",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "panopticlaude.markInboxReviewed",
          "when": "view == panopticlaude.crons && viewItem == cron-inbox",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "panopticlaude.openTodayDraft",
          "when": "false"
        },
        {
          "command": "panopticlaude.postDrafts",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "panopticlaude.sessions",
        "contents": "No live Claude Code sessions."
      },
      {
        "view": "panopticlaude.prs",
        "contents": "No open PRs.\n[Configure panopticlaude.repos](command:workbench.action.openSettings?%22panopticlaude.repos%22)"
      },
      {
        "view": "panopticlaude.worktrees",
        "contents": "No extra worktrees.\n[Configure panopticlaude.repos](command:workbench.action.openSettings?%22panopticlaude.repos%22)"
      },
      {
        "view": "panopticlaude.crons",
        "contents": "No bots configured.\n[Configure panopticlaude.crons](command:workbench.action.openSettings?%22panopticlaude.crons%22)"
      }
    ],
    "configuration": {
      "title": "Panopticlaude",
      "properties": {
        "panopticlaude.repos": {
          "type": "array",
          "default": [],
          "markdownDescription": "Local repo paths (`~` ok) whose open PRs (authored by you) and extra git worktrees show in the My PRs and Worktrees sections.",
          "items": {
            "type": "string"
          }
        },
        "panopticlaude.crons": {
          "type": "array",
          "default": [],
          "markdownDescription": "Headless Claude bots to watch. Each entry: `label` (launchd label, resolves the plist and `launchctl print` status), `log` (file whose tail and mtime show last-run detail), `inbox` (optional directory whose file count shows as a needs-review badge), `repo` (optional owner/name GitHub repo that, with `inbox`, enables opening today's DRAFTS-*.md and posting selected drafts as issue comments).",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "launchd label, e.g. com.example.my-bot"
              },
              "log": {
                "type": "string",
                "description": "Path to the bot's log file"
              },
              "inbox": {
                "type": "string",
                "description": "Directory of files awaiting review"
              },
              "repo": {
                "type": "string",
                "description": "owner/name of the GitHub repo the bot's drafts post to (enables the Post drafts… action; requires inbox)"
              }
            }
          }
        }
      }
    }
  }
}
